rules_version = '2';
// Carnet de jeux — règles Firestore (comptes, codes, amis, résultats, parties partagées, partie en direct, bugs et idées).
// À coller dans Firebase > Firestore Database > Règles, puis « Publier ».
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function pairOf(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    // vrai si l'utilisateur connecté et `other` sont amis confirmés
    function friendOf(other) {
      return signedIn()
        && exists(/databases/$(database)/documents/friendships/$(pairOf(request.auth.uid, other)))
        && get(/databases/$(database)/documents/friendships/$(pairOf(request.auth.uid, other))).data.status == 'ok';
    }

    // Profil minimal : nom affiché + code ami. Jamais d'e-mail ici.
    match /users/{uid} {
      function isMe() { return signedIn() && request.auth.uid == uid; }
      function validName(d) { return d.name is string && d.name.size() >= 1 && d.name.size() <= 24; }

      allow get: if isMe() || friendOf(uid);
      allow create: if isMe()
        && request.resource.data.keys().hasOnly(['name', 'code', 'createdAt'])
        && validName(request.resource.data)
        && request.resource.data.code is string && request.resource.data.code.size() == 6
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid;
      allow update: if isMe()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data);
      allow delete: if isMe();
      allow list: if false;
    }

    // Codes amis : on peut vérifier un code précis, jamais lister.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.size() == 6
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow list, update: if false;
    }

    // Amitiés : un document par paire (uidA_uidB). Demande, puis acceptation par l'autre.
    match /friendships/{pid} {
      function member() { return signedIn() && request.auth.uid in resource.data.members; }

      // lire une paire qui n'existe pas encore est permis (pour savoir si une demande existe déjà)
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if member();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'from', 'status', 'names', 'createdAt'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && request.resource.data.from == request.auth.uid
        && pid == pairOf(request.resource.data.members[0], request.resource.data.members[1])
        && request.resource.data.status == 'pending'
        && request.resource.data.names is map
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.createdAt == request.time;
      // seul le destinataire accepte ; il peut seulement passer à 'ok' et ajouter son nom
      allow update: if member()
        && request.auth.uid != resource.data.from
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'names'])
        && request.resource.data.status == 'ok'
        && request.resource.data.names.keys().hasOnly(resource.data.members);
      // refuser, annuler ou retirer : l'un ou l'autre
      allow delete: if member();
    }

    // Résultats partagés : jeu, date, gagné ou non, points (ou place au 421). Pas de noms d'adversaires.
    match /results/{uid} {
      function isMe() { return signedIn() && request.auth.uid == uid; }
      allow get: if isMe() || friendOf(uid);
      allow create, update: if isMe()
        && request.resource.data.keys().hasOnly(['list', 'updatedAt'])
        && request.resource.data.list is list
        && request.resource.data.list.size() <= 2000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isMe();
      allow list: if false;
    }

    // Boîte aux lettres : un ami confirmé dépose une partie (ou une suppression), seul le destinataire lit et vide.
    match /inbox/{uid}/items/{item} {
      allow get, list, delete: if signedIn() && request.auth.uid == uid;
      allow create: if friendOf(uid)
        && request.resource.data.from == request.auth.uid
        && request.resource.data.sentAt == request.time
        && ((request.resource.data.type == 'game' && request.resource.data.keys().hasOnly(['from', 'type', 'game', 'sentAt']) && request.resource.data.game is map)
          || (request.resource.data.type == 'del' && request.resource.data.keys().hasOnly(['from', 'type', 'gid', 'sentAt']) && request.resource.data.gid is string));
      allow update: if false;
    }

    // Partie en direct : un document par joueur qui saisit et par jeu ({uid}_{jeu}).
    // Lisible seulement par son auteur et par les joueurs de la partie (viewers). Un ami qui ne joue pas ne voit rien.
    match /watch/{wid} {
      function own() { return signedIn() && wid.matches(request.auth.uid + '_(yahtzee|421|skyjo)'); }
      allow get: if signedIn() && (resource == null || own() || request.auth.uid in resource.data.viewers);
      allow list: if signedIn() && request.auth.uid in resource.data.viewers;
      allow create, update: if own()
        && request.resource.data.keys().hasOnly(['owner', 'ownerName', 'k', 'viewers', 'uids', 'status', 'state', 'result', 'updatedAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.viewers is list && request.resource.data.viewers.size() <= 12
        && request.resource.data.state is string && request.resource.data.state.size() < 200000
        && (!('result' in request.resource.data) || (request.resource.data.result is string && request.resource.data.result.size() < 200000))
        && request.resource.data.updatedAt == request.time;
      allow delete: if own();
    }

    // Bugs et idées (v26) : tout compte connecté peut envoyer un message, seul l'administrateur le lit.
    // L'administrateur est désigné par son code ami (visible dans Mon compte, jamais modifiable après création).
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.code == 'TON_CODE_AMI';
    }
    match /feedback/{fid} {
      allow get, list, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'type', 'text', 'app', 'device', 'view', 'createdAt', 'done'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.type in ['bug', 'idea']
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
        && request.resource.data.app is string && request.resource.data.app.size() <= 10
        && request.resource.data.device is string && request.resource.data.device.size() <= 200
        && request.resource.data.view is string && request.resource.data.view.size() <= 40
        && request.resource.data.createdAt == request.time
        && request.resource.data.done == false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && request.resource.data.done is bool;
    }

    // Tout le reste : fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
